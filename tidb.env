export CURRENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export ROOT_DIR="$(dirname "$CURRENT_DIR")"
export SCRIPT_DIR="$CURRENT_DIR/tidb"
export SRC_DIR="$CURRENT_DIR/src"

export KEY_PAIR_NAME="tidb-key"
export KEY_SAVE_PATH="$ROOT_DIR/.ssh/${KEY_PAIR_NAME}.pem"

export CLUSTER_NAME="tidb-cluster"
export CLUSTER_VERSION="v8.5.6"
export TOPOLOGY_FILE="./cluster.yaml"

if [[ -x "$ROOT_DIR/.venv/bin/python" ]]; then
export PYTHON_CMD="$ROOT_DIR/.venv/bin/python"
else
export PYTHON_CMD="python3.12"
fi

export MYSQL_CMD="mysql -u root -P 4000 -h 127.0.0.1"